{
  "description": "terminal and halt_on apply after the status is classified and only upgrade a continue: a terminal task returning 500 still records TASK_STATUS_ERROR and stops the engine; halt_on: failure with 500 likewise propagates; halt_on: failure with 400 halts only its own workflow and the next one runs.",
  "workflows": [
    {
      "id": "terminal_500",
      "name": "terminal_500",
      "tasks": [
        {
          "id": "t",
          "name": "t",
          "terminal": true,
          "function": {
            "name": "script",
            "input": {
              "outcome": {
                "status": 500
              }
            }
          }
        },
        {
          "id": "after",
          "name": "after",
          "function": {
            "name": "map",
            "input": {
              "mappings": [
                {
                  "path": "data.after_ran",
                  "logic": true
                }
              ]
            }
          }
        }
      ]
    },
    {
      "id": "next",
      "name": "next",
      "priority": 1,
      "tasks": [
        {
          "id": "n",
          "name": "n",
          "function": {
            "name": "map",
            "input": {
              "mappings": [
                {
                  "path": "data.next_ran",
                  "logic": true
                }
              ]
            }
          }
        }
      ]
    }
  ],
