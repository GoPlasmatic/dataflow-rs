{
  "description": "A run stamps metadata.processed_at, engine_version and, on a channel run, channel; metadata.progress is written after every executed task, a failed one included, but not after a filter's skip or a task whose condition is false.",
  "workflows": [
    {"id": "w", "name": "w", "channel": "c", "tasks": [
      {"id": "first", "name": "first", "function": {"name": "map", "input": {"mappings": [
        {"path": "data.first", "logic": 1}]}}},
      {"id": "fails", "name": "fails", "continue_on_error": true, "function": {"name": "script", "input": {
        "outcome": {"status": 500}}}},
      {"id": "skips", "name": "skips", "function": {"name": "filter", "input": {
        "condition": false, "on_reject": "skip"}}},
      {"id": "never", "name": "never", "condition": false, "function": {"name": "map", "input": {"mappings": [
        {"path": "data.never", "logic": 1}]}}}]}
  ],
  "steps": [
    {"run": {"message": {"id": "on_channel", "metadata": {"source": "api", "channel": "seeded"}}, "channel": "c"}},
    {"run": {"message": {"id": "no_channel", "metadata": {"source": "api"}}}}
  ]
}
