{
  "description": "A reload keeps the engine's handlers (script), custom operators (shout), secrets, observer and error context (path and limit): the reloaded definitions use every one of them, and both runs show them working.",
  "engine": {
    "operators": [
      "shout"
    ],
    "secrets": {
      "k": "s3cr3t"
    },
    "observer": true,
    "error_context": {
      "path": "metadata.failures",
      "limit": 2
    }
  },
  "workflows": [
    {
      "id": "w_before",
      "name": "w_before",
      "tasks": [
        {
          "id": "loud",
          "name": "loud",
          "function": {
            "name": "map",
            "input": {
              "mappings": [
                {
                  "path": "data.loud_before",
                  "logic": {
                    "shout": [
                      "hi before"
                    ]
                  }
                }
              ]
            }
          }
        },
        {
          "id": "secret",
          "name": "secret",
          "function": {
            "name": "script",
            "input": {
              "set": [
                {
                  "path": "data.secret_ok_before",
                  "value": {
                    "==": [
                      {
                        "secret": "k"
                      },
                      "s3cr3t"
                    ]
                  }
                }
              ]
            }
          }
        },
        {
          "id": "fail_1",
          "name": "fail_1",
          "continue_on_error": true,
          "function": {
            "name": "script",
            "input": {
              "outcome": {
                "status": 500
              }
            }
          }
        },
        {
          "id": "fail_2",
          "name": "fail_2",
          "continue_on_error": true,
          "function": {
            "name": "script",
            "input": {
              "outcome": {
                "error": {
                  "variant": "service",
                  "code": "PARTNER_DOWN",
                  "message": "down"
                }
              }
            }
          }
        },
        {
          "id": "fail_3",
          "name": "fail_3",
          "continue_on_error": true,
          "function": {
            "name": "script",
            "input": {
              "outcome": {
                "status": 503
              }
            }
          }
        }
      ]
    }
  ],
  "steps": [
    {
      "run": {
        "message": {
          "id": "before"
        }
      }
    },
    {
      "reload": {
        "workflows": [
          {
            "id": "w_after",
            "name": "w_after",
            "tasks": [
              {
                "id": "loud",
                "name": "loud",
                "function": {
                  "name": "map",
                  "input": {
                    "mappings": [
                      {
                        "path": "data.loud_after",
                        "logic": {
                          "shout": [
                            "hi after"
                          ]
                        }
                      }
                    ]
                  }
                }
              },
              {
                "id": "secret",
                "name": "secret",
                "function": {
                  "name": "script",
                  "input": {
                    "set": [
                      {
                        "path": "data.secret_ok_after",
                        "value": {
                          "==": [
                            {
                              "secret": "k"
                            },
                            "s3cr3t"
                          ]
                        }
                      }
                    ]
                  }
                }
              },
              {
                "id": "fail_1",
                "name": "fail_1",
                "continue_on_error": true,
                "function": {
                  "name": "script",
                  "input": {
                    "outcome": {
                      "status": 500
                    }
                  }
                }
              },
              {
                "id": "fail_2",
                "name": "fail_2",
                "continue_on_error": true,
                "function": {
                  "name": "script",
                  "input": {
                    "outcome": {
                      "error": {
                        "variant": "service",
                        "code": "PARTNER_DOWN",
                        "message": "down"
                      }
                    }
                  }
                }
              },
              {
                "id": "fail_3",
                "name": "fail_3",
                "continue_on_error": true,
                "function": {
                  "name": "script",
                  "input": {
                    "outcome": {
                      "status": 503
                    }
                  }
                }
              }
            ]
          }
        ]
      }
    },
    {
      "run": {
        "message": {
          "id": "after"
        }
      }
    }
  ]
}
