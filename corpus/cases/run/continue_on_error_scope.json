{
  "description": "continue_on_error covers 5xx and Err only: a 4xx is recorded and the next task runs regardless; a 5xx or Err under continue_on_error is recorded and the next task runs; a 5xx without it stops the engine.",
  "covers": ["run.continue-on-error"],
  "mirrors": ["tests/error_handling.rs::task_status_500_pushes_status_error_to_message", "src/workflow_executor::a_4xx_task_status_is_recorded_per_sweep_without_stopping_the_loop"],
  "workflows": [
    {"id": "w", "name": "w", "tasks": [
      {"id": "rejected", "name": "rejected", "function": {"name": "script", "input": {"outcome": {"status": 400}}}},
      {"id": "after_400", "name": "after_400", "function": {"name": "map", "input": {"mappings": [{"path": "data.after_400", "logic": true}]}}},
      {"id": "failed", "name": "failed", "continue_on_error": true, "function": {"name": "script", "input": {"outcome": {"status": 500}}}},
      {"id": "after_500", "name": "after_500", "function": {"name": "map", "input": {"mappings": [{"path": "data.after_500", "logic": true}]}}},
      {"id": "erred", "name": "erred", "continue_on_error": true, "function": {"name": "script", "input": {"outcome": {"error": {"variant": "task", "message": "tolerated"}}}}},
      {"id": "after_err", "name": "after_err", "function": {"name": "map", "input": {"mappings": [{"path": "data.after_err", "logic": true}]}}},
      {"id": "stops", "name": "stops", "function": {"name": "script", "input": {"outcome": {"status": 503}}}},
      {"id": "never", "name": "never", "function": {"name": "map", "input": {"mappings": [{"path": "data.never", "logic": true}]}}}]}
  ],
  "steps": [{"run": {"message": {}}}],
  "deviations": [
    {"break": "4", "paths": ["/steps/0/run/message/errors/3"],
     "note": "v4 adds no WORKFLOW_ERROR wrapper: the task's own record carries the workflow id"}
  ]
}
