{
  "description": "A host Function reads its identity (workflow_id and task_id, with loop_counter and element_index null outside a loop and a fan-out), writes through Ctx::set with each write audited, records an error of its own (stamped with no workflow or task id), and returns a status (201). A function that writes and then returns Skip gets no audit entry and no progress write, but its write stays in the context, unaudited.",
  "workflows": [
    {
      "id": "w",
      "name": "w",
      "tasks": [
        {
          "id": "host",
          "name": "host",
          "function": {
            "name": "script",
            "input": {
              "identity": "data.identity",
              "set": [
                {
                  "path": "data.first",
                  "value": {
                    "cat": [
                      "seen ",
                      {
                        "var": "data.input"
                      }
                    ]
                  }
                },
                {
                  "path": "temp_data.second",
                  "raw": {
                    "kept": "verbatim"
                  }
                }
              ],
              "errors": [
                {
                  "code": "HOST_WARNING",
                  "message": "recorded by the handler"
                }
              ],
              "outcome": {
                "status": 201
              }
            }
          }
        },
        {
          "id": "skipper",
          "name": "skipper",
          "function": {
            "name": "script",
            "input": {
              "set": [
                {
                  "path": "data.skipper_wrote",
                  "raw": true
                }
              ],
              "outcome": "skip"
            }
          }
        }
      ]
    }
  ],
  "steps": [
    {
      "run": {
        "message": {
          "data": {
            "input": "x"
          }
        }
      }
    }
  ]
}
