{
  "description": "A halt breaks the whole loop, not one sweep: a rejecting filter at counter 1 ends its loop after sweep 1, and so does a terminal task at counter 1; a later workflow still runs.",
  "workflows": [
    {
      "id": "filtered",
      "name": "filtered",
      "loop": {
        "counter": "i",
        "max": 5
      },
      "tasks": [
        {
          "id": "t",
          "name": "t",
          "function": {
            "name": "map",
            "input": {
              "mappings": [
                {
                  "path": "data.seen",
                  "logic": {
                    "var": "temp_data.i"
                  },
                  "mode": "append"
                }
              ]
            }
          }
        },
        {
          "id": "gate",
          "name": "gate",
          "function": {
            "name": "filter",
            "input": {
              "condition": {
                "!=": [
                  {
                    "var": "temp_data.i"
                  },
                  1
                ]
              }
            }
          }
        }
      ]
    },
    {
      "id": "terminal",
      "name": "terminal",
      "priority": 1,
      "loop": {
        "counter": "i",
        "max": 5
      },
      "tasks": [
        {
          "id": "t",
          "name": "t",
          "function": {
            "name": "map",
            "input": {
              "mappings": [
                {
                  "path": "data.terminal",
                  "logic": {
                    "var": "temp_data.i"
                  },
                  "mode": "append"
                }
              ]
            }
          }
        },
        {
          "id": "exit",
          "name": "exit",
          "terminal": true,
          "condition": {
            "==": [
              {
                "var": "temp_data.i"
              },
              1
            ]
          },
          "function": {
            "name": "map",
            "input": {
              "mappings": [
                {
                  "path": "data.exit",
                  "logic": true
                }
              ]
            }
          }
        }
      ]
    },
    {
      "id": "after",
      "name": "after",
      "priority": 2,
      "tasks": [
        {
          "id": "after",
          "name": "after",
          "function": {
            "name": "map",
            "input": {
              "mappings": [
                {
                  "path": "data.after",
                  "logic": true
                }
              ]
            }
          }
        }
      ]
    }
  ],
  "steps": [
    {
      "run": {
        "message": {}
      }
    }
  ]
}
