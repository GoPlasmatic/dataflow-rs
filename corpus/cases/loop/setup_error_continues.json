{
  "description": "A setup step that fails, in a workflow with continue_on_error, is recorded; no sweep runs, and the next workflow does.",
  "covers": [
    "loop.setup"
  ],
  "mirrors": [
    "src/workflow_executor::a_setup_error_stops_the_message_unless_the_workflow_continues_on_error"
  ],
  "workflows": [
    {
      "id": "w",
      "name": "w",
      "continue_on_error": true,
      "loop": {
        "counter": "i",
        "max": 3,
        "setup": [
          {
            "id": "boom",
            "name": "boom",
            "function": {
              "name": "script",
              "input": {
                "outcome": {
                  "error": {
                    "variant": "task",
                    "message": "setup failed"
                  }
                }
              }
            }
          }
        ]
      },
      "tasks": [
        {
          "id": "t",
          "name": "t",
          "function": {
            "name": "map",
            "input": {
              "mappings": [
                {
                  "path": "data.seen",
                  "logic": {
                    "var": "temp_data.i"
                  },
                  "mode": "append"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "id": "after",
      "name": "after",
      "priority": 1,
      "tasks": [
        {
          "id": "after",
          "name": "after",
          "function": {
            "name": "map",
            "input": {
              "mappings": [
                {
                  "path": "data.after",
                  "logic": true
                }
              ]
            }
          }
        }
      ]
    }
  ],
  "steps": [
    {
      "run": {
        "message": {}
      }
    }
  ],
  "deviations": [
    {
      "break": "4",
      "paths": [
        "/steps/0/run/message/errors/1",
        "/steps/0/run/trace/steps/0/message/errors/1"
      ],
      "note": "v4 adds no WORKFLOW_ERROR wrapper: the task's own record carries the workflow id"
    },
    {
      "break": "5",
      "paths": [
        "/steps/0/run/trace/steps/0/message/errors/0"
      ],
      "note": "the failing setup call's record is on its own failed step, which v3's trace drops, so v3's next snapshot gained it"
    }
  ]
}
