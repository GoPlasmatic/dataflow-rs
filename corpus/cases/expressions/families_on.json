{
  "description": "With the families on, the same literals become live operator calls: starts_with, abs and the tensor shape evaluate, and == compares datetime-shaped strings as instants. Enabling a family changes what existing definitions do.",
  "requires": {"on": ["datetime", "tensor"]},
  "engine": {"families": ["all-operators", "tensor"]},
  "workflows": [
    {"id": "w", "name": "w", "tasks": [
      {"id": "t", "name": "t", "function": {"name": "map", "input": {"mappings": [
        {"path": "data.starts_with", "logic": {"starts_with": ["hello", "he"]}},
        {"path": "data.abs", "logic": {"abs": -5}},
        {"path": "data.shape", "logic": {"shape": [{"tensor": [[1, 2, 3], "u8"]}]}},
        {"path": "data.escaped_shape", "logic": {"$shape": [1, 2, 3]}},
        {"path": "data.dates_equal", "logic": {"==": ["2024-01-15T00:00:00Z", "2024-01-15T01:00:00+01:00"]}}]}}}]}
  ],
  "steps": [{"run": {"message": {}}}]
}
