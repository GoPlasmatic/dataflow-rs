{
  "description": "Exactly one leading $ is stripped from every template key: $cat emits the literal key cat, $$x emits $x, an unescaped cat is the operator, and an escaped key with a computed value is evaluated rather than folded (reported as an advisory).",
  "workflows": [
    {
      "id": "w",
      "name": "w",
      "tasks": [
        {
          "id": "t",
          "name": "t",
          "function": {
            "name": "map",
            "input": {
              "mappings": [
                {
                  "path": "data.escaped",
                  "logic": {
                    "$cat": [
                      "a",
                      "b"
                    ]
                  }
                },
                {
                  "path": "data.operator",
                  "logic": {
                    "cat": [
                      "a",
                      "b"
                    ]
                  }
                },
                {
                  "path": "data.double",
                  "logic": {
                    "$$x": 1
                  }
                },
                {
                  "path": "data.triple",
                  "logic": {
                    "$$$oid": "abc"
                  }
                },
                {
                  "path": "data.computed",
                  "logic": {
                    "$oid": {
                      "var": "data.id"
                    },
                    "kind": "ref"
                  }
                }
              ]
            }
          }
        }
      ]
    }
  ],
  "steps": [
    {
      "run": {
        "message": {
          "data": {
            "id": "abc"
          }
        }
      }
    }
  ]
}
