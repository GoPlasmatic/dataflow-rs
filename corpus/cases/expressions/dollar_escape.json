{
  "description": "Exactly one leading $ is stripped from every template key: $cat emits the literal key cat, $$x emits $x, an unescaped cat is the operator, and an escaped key with a computed value is evaluated rather than folded (reported as an advisory).",
  "covers": [
    "expr.dollar-escape",
    "break.14"
  ],
  "mirrors": [
    "tests/template_keys.rs::exactly_one_prefix_is_stripped",
    "tests/template_keys.rs::an_escaped_key_emits_the_literal_object",
    "tests/template_keys.rs::escaped_keys_are_reported_for_audit_but_never_refused"
  ],
  "workflows": [
    {
      "id": "w",
      "name": "w",
      "tasks": [
        {
          "id": "t",
          "name": "t",
          "function": {
            "name": "map",
            "input": {
              "mappings": [
                {
                  "path": "data.escaped",
                  "logic": {
                    "$cat": [
                      "a",
                      "b"
                    ]
                  }
                },
                {
                  "path": "data.operator",
                  "logic": {
                    "cat": [
                      "a",
                      "b"
                    ]
                  }
                },
                {
                  "path": "data.double",
                  "logic": {
                    "$$x": 1
                  }
                },
                {
                  "path": "data.triple",
                  "logic": {
                    "$$$oid": "abc"
                  }
                },
                {
                  "path": "data.computed",
                  "logic": {
                    "$oid": {
                      "var": "data.id"
                    },
                    "kind": "ref"
                  }
                }
              ]
            }
          }
        }
      ]
    }
  ],
  "steps": [
    {
      "run": {
        "message": {
          "data": {
            "id": "abc"
          }
        }
      }
    }
  ],
  "deviations": [
    {
      "break": "14",
      "paths": [
        "/definitions/0/checked"
      ],
      "note": "v4 reports ESCAPED_TEMPLATE_KEY only for a key with a single leading `$` (R42); v3 also reports the `$$x` and `$$$oid` keys"
    }
  ]
}
