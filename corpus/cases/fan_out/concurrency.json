{
  "description": "max_concurrency changes timing, never results: the same message at max_concurrency 1 and 4. Each call yields as many times as its element's `y`, so at 4 the calls finish out of order (element 2, then 3, 1, 0), and the fold is still in element order, including a failed element under continue_on_error.",
  "workflows": [
    {
      "id": "w",
      "name": "w",
      "tasks": [
        {
          "id": "t",
          "name": "t",
          "for_each": {
            "over": {
              "var": "data.items"
            },
            "as": "p",
            "max_concurrency": 1,
            "collect": "temp_data.out",
            "into": "data.results"
          },
          "function": {
            "name": "script",
            "input": {
              "yields": {
                "var": "temp_data.p.y"
              },
              "set": [
                {
                  "path": "temp_data.out",
                  "value": {
                    "cat": [
                      "r",
                      {
                        "var": "temp_data.p_index"
                      }
                    ]
                  }
                }
              ],
              "outcome": {
                "var": "temp_data.p.o"
              }
            }
          },
          "continue_on_error": true
        },
        {
          "id": "after",
          "name": "after",
          "function": {
            "name": "map",
            "input": {
              "mappings": [
                {
                  "path": "data.after_ran",
                  "logic": true
                }
              ]
            }
          }
        }
      ]
    }
  ],
  "steps": [
    {
      "run": {
        "message": {
          "data": {
            "items": [
              {
                "o": "success",
                "y": 3
              },
              {
                "o": "success",
                "y": 2
              },
              {
                "o": {
                  "status": 500
                },
                "y": 0
              },
              {
                "o": "success",
                "y": 1
              },
              {
                "o": "success",
                "y": 0
              },
              {
                "o": "success",
                "y": 2
              }
            ]
          }
        }
      }
    },
    {
      "reload": {
        "workflows": [
          {
            "id": "w",
            "name": "w",
            "tasks": [
              {
                "id": "t",
                "name": "t",
                "for_each": {
                  "over": {
                    "var": "data.items"
                  },
                  "as": "p",
                  "max_concurrency": 4,
                  "collect": "temp_data.out",
                  "into": "data.results"
                },
                "function": {
                  "name": "script",
                  "input": {
                    "yields": {
                      "var": "temp_data.p.y"
                    },
                    "set": [
                      {
                        "path": "temp_data.out",
                        "value": {
                          "cat": [
                            "r",
                            {
                              "var": "temp_data.p_index"
                            }
                          ]
                        }
                      }
                    ],
                    "outcome": {
                      "var": "temp_data.p.o"
                    }
                  }
                },
                "continue_on_error": true
              },
              {
                "id": "after",
                "name": "after",
                "function": {
                  "name": "map",
                  "input": {
                    "mappings": [
                      {
                        "path": "data.after_ran",
                        "logic": true
                      }
                    ]
                  }
                }
              }
            ]
          }
        ]
      }
    },
    {
      "run": {
        "message": {
          "data": {
            "items": [
              {
                "o": "success",
