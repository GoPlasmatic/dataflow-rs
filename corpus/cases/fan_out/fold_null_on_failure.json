{
  "description": "The fold runs in element order; under continue_on_error an element that fails leaves null in into. In v3 a 5xx element's own writes are still replayed into the message (its changes are audited), while an Err element contributes no writes and an empty change list; the rest fold normally.",
  "workflows": [
    {"id": "w", "name": "w", "tasks": [
      {"id": "t", "name": "t", "continue_on_error": true,
       "for_each": {"over": {"var": "data.items"}, "as": "p", "collect": "temp_data.out", "into": "data.results"},
       "function": {"name": "script", "input": {
         "set": [
           {"path": "temp_data.out", "value": {"var": "temp_data.p_index"}},
           {"path": "temp_data.last_writer", "value": {"var": "temp_data.p_index"}}],
         "outcome": {"var": "temp_data.p.o"}}}},
      {"id": "after", "name": "after", "function": {"name": "map", "input": {"mappings": [
        {"path": "data.after_ran", "logic": true}]}}}]}
  ],
  "steps": [{"run": {"message": {"data": {"items": [
    {"o": "success"},
    {"o": {"status": 500}},
    {"o": {"error": {"variant": "task", "message": "boom"}}},
    {"o": "success"}]}}}}]
}
