{
  "description": "A rollout is {bucket_start, bucket_end}, half-open over 0..100: bucket 0 and 49 run a, 50 runs b, a workflow without a rollout runs for every bucket, and a message with no bucket is admitted by every split.",
  "workflows": [
    {"id": "a", "name": "a", "priority": 0, "rollout": {"bucket_start": 0, "bucket_end": 50}, "tasks": [
      {"id": "t", "name": "t", "function": {"name": "map", "input": {"mappings": [
        {"path": "data.order", "logic": "a", "mode": "append"}]}}}]},
    {"id": "b", "name": "b", "priority": 1, "rollout": {"bucket_start": 50, "bucket_end": 100}, "tasks": [
      {"id": "t", "name": "t", "function": {"name": "map", "input": {"mappings": [
        {"path": "data.order", "logic": "b", "mode": "append"}]}}}]},
    {"id": "all", "name": "all", "priority": 2, "tasks": [
      {"id": "t", "name": "t", "function": {"name": "map", "input": {"mappings": [
        {"path": "data.order", "logic": "all", "mode": "append"}]}}}]}
  ],
  "steps": [
    {"run": {"message": {"id": "bucket_0"}, "routing_bucket": 0}},
    {"run": {"message": {"id": "bucket_49"}, "routing_bucket": 49}},
    {"run": {"message": {"id": "bucket_50"}, "routing_bucket": 50}},
    {"run": {"message": {"id": "bucket_99"}, "routing_bucket": 99}},
    {"run": {"message": {"id": "no_bucket"}}}
  ]
}
