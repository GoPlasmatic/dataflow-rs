{
  "name": "@goplasmatic/dataflow-ui",
  "version": "4.0.2",
  "type": "module",
  "description": "React visualization library for dataflow-rs workflow engine",
  "author": "Plasmatic Engineering <shankar@goplasmatic.io>",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/lib.d.ts",
  "exports": {
    ".": {
      "types": "./dist/lib.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/dataflow-ui.css"
  },
  "files": [
    "dist",
    "README.md",
    "!dist/*.map"
  ],
  "homepage": "https://github.com/GoPlasmatic/dataflow-rs",
  "repository": {
    "type": "git",
    "url": "https://github.com/GoPlasmatic/dataflow-rs",
    "directory": "ui"
  },
  "bugs": {
    "url": "https://github.com/GoPlasmatic/dataflow-rs/issues"
  },
  "license": "Apache-2.0",
  "keywords": [
    "workflow",
    "dataflow",
    "visualization",
    "react",
    "jsonlogic",
    "typescript"
  ],
  "scripts": {
    "predev": "node scripts/use-local-wasm.mjs --if-available",
    "dev": "vite",
    "build": "tsc && vite build",
    "postbuild": "node scripts/verify-app-bundle.mjs",
    "build:lib": "tsc && vite build --config vite.lib.config.ts",
    "postbuild:lib": "node scripts/verify-dts.mjs",
    "preview": "vite preview",
    "wasm:local": "node scripts/use-local-wasm.mjs",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "prepublishOnly": "npm run build:lib",
    "publish:npm": "npm run build:lib && npm publish --access public",
    "test": "tsc --noEmit -p tsconfig.test.json && vitest run"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.1",
    "@goplasmatic/dataflow-wasm": "^4.0.0",
    "@goplasmatic/datalogic-ui": "^5.9.0",
    "@monaco-editor/react": "^4.7.0",
    "@xyflow/react": "12.12.0",
    "lucide-react": "^1.59.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "monaco-editor": "^0.57.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.4",
    "vite-plugin-dts": "^5.1.2",
    "vite-plugin-wasm": "^3.6.0",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "dompurify": "^3.4.17"
  }
}
